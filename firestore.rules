// firestore.rules
// Deploy with: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────
    function isAuth()        { return request.auth != null; }
    function isOwner(uid)    { return isAuth() && request.auth.uid == uid; }
    function getUser()       { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin()       { return isAuth() && getUser().role == 'admin'; }
    function isDriver()      { return isAuth() && getUser().role == 'driver'; }
    function isApprovedDriver() {
      return isDriver() && get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.status == 'approved';
    }

    // ── Users ─────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Drivers ───────────────────────────────────────────────
    match /drivers/{driverId} {
      allow read:   if isOwner(driverId) || isAdmin() || isAuth();
      allow create: if isOwner(driverId);
      allow update: if isOwner(driverId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Rides ─────────────────────────────────────────────────
    match /rides/{rideId} {
      allow read:   if isAuth() && (
        resource.data.userId   == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        resource.data.userId   == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Shared Rides ──────────────────────────────────────────
    match /sharedRides/{rideId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAdmin();
    }

    // ── Transactions ──────────────────────────────────────────
    match /transactions/{txId} {
      allow read:  if isAuth() && (
        resource.data.userId   == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth();
      allow update: if isAdmin();
    }

    // ── Messages ──────────────────────────────────────────────
    match /messages/{rideId}/chat/{msgId} {
      allow read, write: if isAuth();
    }

    // ── Notifications ─────────────────────────────────────────
    match /notifications/{userId}/items/{notifId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ── Feedback ──────────────────────────────────────────────
    match /feedback/{feedbackId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAdmin();
    }

    // ── Earnings ──────────────────────────────────────────────
    match /earnings/{driverId} {
      allow read:  if isOwner(driverId) || isAdmin();
      allow write: if isAdmin();
    }
  }
}
